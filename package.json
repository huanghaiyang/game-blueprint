    "build": "vite build --config web/vite.config.js --configLoader runner",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "reset": "node server/reset.js",
    "fix:sandbox": "node scripts/fix-sandbox.mjs",
    "audit": "node scripts/audit.mjs",
    "mcp": "node mcp/server.mjs",
    "qa:world": "node scripts/qa-world.mjs",
    "qa:world:edit": "node scripts/qa-world-edit.mjs",
    "qa:world:undo": "node scripts/qa-world-undo.mjs",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "test": "node server/tests/run.js"
  },
  "dependencies": {
    "three": "^0.171.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
